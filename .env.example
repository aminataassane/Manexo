APP_NAME=Manexo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# BACKUP_ENCRYPTION_KEY=  # Set a separate key for backup encryption (falls back to APP_KEY)
APP_URL=http://localhost

# Couleur par défaut de l'UI (si l'entreprise n'a pas de primary_color)
MANEXO_DEFAULT_ACCENT=#005F02

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Temps réel (messages / notifications sans recharger la page).
# 1) BROADCAST_CONNECTION=reverb + `php artisan reverb:start` (ou Reverb derrière Supervisor en prod).
# 2) Variables VITE_REVERB_* + `npm run build` (ou dev) pour que le navigateur ouvre le WebSocket.
# Les événements critiques utilisent ShouldBroadcastNow : pas besoin de `queue:work` pour les pousser.
# Sans Reverb : BROADCAST_CONNECTION=log et retirer VITE_REVERB_APP_KEY (sinon erreurs console).
BROADCAST_CONNECTION=log
# Exemple local avec Reverb (copier les valeurs dans .env ; Vite lit VITE_* au build) :
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=manexo
# REVERB_APP_KEY=manexo-local-key
# REVERB_APP_SECRET=change-me
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY=manexo-local-key
# VITE_REVERB_HOST=localhost
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
# Si un proxy termine le TLS devant Reverb sur 8080 : VITE_REVERB_FORCE_TLS=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
