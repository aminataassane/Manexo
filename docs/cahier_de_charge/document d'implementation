Point critique : append intelligent des nouveaux messages

Quand onNewMessage est reçu via WebSocket, ne pas faire $refresh. Au lieu de ça :


public function onNewMessage(array $payload = []): void
{
    if (isset($payload['user_id']) && (int) $payload['user_id'] === auth()->id()) {
        return;
    }
    // Charger uniquement le nouveau message
    $msg = TicketMessage::with('user:id,name,email')
        ->find($payload['message_id'] ?? 0);
    if ($msg) {
        $this->newItems[] = TimelineItem::fromMessage($msg, $this->ticketCreatorId, auth()->id());
        // Livewire rend uniquement les nouveaux items grâce à wire:key
    }
}
